    "name": "JobTrackr API",
    "description": "Every route of the JobTrackr API plus error cases. Run it top to bottom with the Collection Runner (Create sets applicationId for the requests after it). Restart the server before a run so the in-memory data is fresh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Applications",
      "item": [
        {
          "name": "Get all applications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns a list\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    pm.expect(body.count).to.eql(body.data.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            }
          }
        },
        {
          "name": "Filter by status and search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Only Interview apps matching 'google'\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.length).to.be.above(0);",
                  "    body.data.forEach(function (app) {",
                  "        pm.expect(app.status).to.eql(\"Interview\");",
                  "        pm.expect((app.company + \" \" + app.role).toLowerCase()).to.include(\"google\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications?status=Interview&search=google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Interview"
                },
                {
                  "key": "search",
                  "value": "google"
                }
              ]
            }
          }
        },
        {
          "name": "Create application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Returns the new application with an id\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.id).to.be.a(\"string\");",
                  "    pm.expect(body.data.company).to.eql(\"Postman Labs\");",
                  "    pm.expect(body.data.status).to.eql(\"Applied\");",
                  "    pm.collectionVariables.set(\"applicationId\", body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Postman Labs\",\n  \"role\": \"API Intern\",\n  \"appliedOn\": \"2026-10-25\",\n  \"priority\": \"High\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get one application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
