  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has the seeded users, saves the first id\", function () {",
                  "    const users = pm.response.json().data;",
                  "    pm.expect(users.length).to.be.at.least(2);",
                  "    pm.collectionVariables.set(\"userId\", users[0]._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "List (page 1, default limit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has pagination info\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.limit).to.eql(10);",
                  "    pm.expect(body.data.length).to.be.at.most(10);",
                  "    pm.expect(body.totalPages).to.eql(Math.ceil(body.total / body.limit));",
                  "});",
                  "pm.test(\"Owner is populated with name and email\", function () {",
                  "    const owner = pm.response.json().data[0].owner;",
                  "    pm.expect(owner).to.have.property(\"name\");",
                  "    pm.expect(owner).to.have.property(\"email\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
