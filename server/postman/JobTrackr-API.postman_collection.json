  "info": {
    "_postman_id": "fc7d66bb-71a2-484d-8cc2-0e2e81eb5642",
    "name": "JobTrackr API",
    "description": "Every route of the JobTrackr API plus error cases. Run `npm run seed` first, then run the collection top to bottom with the Collection Runner (Get users and Create save ids for the requests after them).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
