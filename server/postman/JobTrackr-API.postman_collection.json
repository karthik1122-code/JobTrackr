    {
      "name": "Event loop demo",
      "item": [
        {
          "name": "Slow (non-blocking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Took about 3 seconds\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.above(2900);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/slow",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "slow"
              ]
            },
            "description": "Waits 3s with setTimeout. Other requests still get answered straight away."
          }
        },
        {
          "name": "Block (busy loop)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Took about 3 seconds\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.above(2900);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/block",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "block"
              ]
            },
            "description": "Runs a 3s busy loop. Every other request waits until it finishes."
          }
        }
      ]
