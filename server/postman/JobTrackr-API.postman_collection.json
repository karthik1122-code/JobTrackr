                  "});",
                  "pm.test(\"Returns the right application\", function () {",
                  "    pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get(\"applicationId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
