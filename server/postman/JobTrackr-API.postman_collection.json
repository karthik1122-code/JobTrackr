        {
          "name": "Filter by owner, status and search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Only this owner's Interview apps matching 'google'\", function () {",
                  "    const userId = pm.collectionVariables.get(\"userId\");",
                  "    pm.response.json().data.forEach(function (app) {",
                  "        pm.expect(app.owner._id).to.eql(userId);",
                  "        pm.expect(app.status).to.eql(\"Interview\");",
                  "        pm.expect((app.company + \" \" + app.role).toLowerCase()).to.include(\"google\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications?owner={{userId}}&status=Interview&search=google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ],
              "query": [
                {
                  "key": "owner",
                  "value": "{{userId}}"
                },
                {
                  "key": "status",
                  "value": "Interview"
                },
                {
                  "key": "search",
                  "value": "google"
                }
              ]
            }
          }
        },
        {
          "name": "Stats (aggregation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Count per status and average offer salary\", function () {",
                  "    const data = pm.response.json().data;",
                  "    [\"Applied\", \"Interview\", \"Offer\", \"Rejected\"].forEach(function (s) {",
                  "        pm.expect(data.byStatus[s]).to.be.a(\"number\");",
                  "    });",
                  "    const sum = Object.values(data.byStatus).reduce(function (a, b) { return a + b; }, 0);",
                  "    pm.expect(sum).to.eql(data.total);",
                  "    pm.expect(data.averageOfferSalary).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
